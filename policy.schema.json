{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nintechio/changefence/main/policy.schema.json",
  "title": "changefence policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_files": { "type": "integer", "minimum": 0 },
    "max_additions": { "type": "integer", "minimum": 0 },
    "max_deletions": { "type": "integer", "minimum": 0 },
    "max_lines_per_file": { "type": "integer", "minimum": 0 },
    "allowed": { "$ref": "#/$defs/globs" },
    "forbidden": { "$ref": "#/$defs/globs" },
    "protected": { "$ref": "#/$defs/globs" },
    "test_patterns": { "$ref": "#/$defs/globs" },
    "source_patterns": { "$ref": "#/$defs/globs" },
    "require_tests_for_source": { "type": "boolean" },
    "allow_dependency_changes": { "type": "boolean" }
  },
  "$defs": {
    "globs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
